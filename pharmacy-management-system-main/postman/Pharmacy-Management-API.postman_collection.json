                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\u0027Invoices list status is 200\u0027, function () {",
                                                                   "  pm.response.to.have.status(200);",
                                                                   "});",
                                                                   "const json = pm.response.json();",
                                                                   "pm.test(\u0027Invoices list is an array\u0027, function () {",
                                                                   "  pm.expect(json).to.be.an(\u0027array\u0027);",
                                                                   "});",
                                                                   "const targetInvoiceId = String(pm.environment.get(\u0027invoice_id\u0027) || \u0027\u0027);",
                                                                   "if (targetInvoiceId) {",
                                                                   "  const matched = json.find(x =\u003e String(x.id) === targetInvoiceId);",
                                                                   "  pm.test(\u0027Created invoice appears in list\u0027, function () {",
                                                                   "    pm.expect(matched, \u0027invoice_id not found in list\u0027).to.exist;",
                                                                   "  });",
                                                                   "}"
                                                               ]
                                                  }
