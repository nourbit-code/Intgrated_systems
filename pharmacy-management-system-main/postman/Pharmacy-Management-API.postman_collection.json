                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\u0027Invoice created\u0027, function () {",
                                                                   "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                                                                   "});",
                                                                   "const json = pm.response.json();",
                                                                   "pm.test(\u0027Created invoice has id\u0027, function () {",
                                                                   "  pm.expect(json.id, \u0027id missing\u0027).to.exist;",
                                                                   "});",
                                                                   "pm.test(\u0027Created invoice amount is positive\u0027, function () {",
                                                                   "  pm.expect(Number(json.amount || 0)).to.be.above(0);",
                                                                   "});",
                                                                   "pm.test(\u0027Created invoice has expected status\u0027, function () {",
                                                                   "  pm.expect(String(json.status || \u0027\u0027).toLowerCase()).to.be.oneOf([\u0027pending\u0027, \u0027paid\u0027]);",
                                                                   "});",
                                                                   "if (json.id) pm.environment.set(\u0027invoice_id\u0027, json.id);"
                                                               ]
                                                  }
                                   }
